{
  "manifest_version": 3,
  "name": "Transliterate",
  "version": "1.0",

  "description": "Transliterate selected text.",

  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "scripting"
  ],

  "background": {
    "scripts": ["dist/background.js"]
  },

  "icons": {
    "48": "icons/border-48.jpg"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "transliterate@mozilla.org"
    }
  }
}